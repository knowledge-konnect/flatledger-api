  // Production origins are injected via environment variables on Render:
  //   AllowedOrigins__4=https://yourapp.vercel.app
  //   AllowedOrigins__5=https://www.yourapp.com
  // Add one env var per origin using sequential indices (4, 5, 6, ...).
  // The array is merged — dev origins above are always included.
  "BackgroundServices": {
    "TrialExpirationIntervalHours": 24,
    "TrialExpirationRetryMinutes": 5,
    "MonthlyBillRetryMinutes": 5,
    "MonthlyBillMaxRetryAttempts": 3,
    "BillingCatchupLookbackMonths": 3
  }
